a = np.array([
    [1, 2, 3],
    [4, 5, 6]
])
b = np.array([
    [1, 1, 2],
    [3, 5, 8]
])

print("Sum:", a + b)
print("product", a * b)
'''
> Sum: [[ 2  3]
> [ 5  7]
> [10 14]]
print("Product:", a * b) # This is the element-wise product (Hadamard product)

> Product: [[ 1  2]
> [ 6 12]
> [25 48]] '''
